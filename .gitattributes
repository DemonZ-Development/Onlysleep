# Force LF line endings for all source files
*.java          text eol=lf
*.kt            text eol=lf
*.kts           text eol=lf
*.gradle        text eol=lf
*.properties    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.xml           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.ts            text eol=lf

# Shell scripts
gradlew         text eol=lf
gradlew.bat     text eol=crlf

# Binary files (never touch line endings)
*.jar           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.class         binary
